<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LocalWinAI.WorkspacesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LocalWinAI"
    xmlns:workspaces="using:LocalWinAI.Application.Workspaces"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ─── Left pane: workspace list ─── -->
        <Grid Grid.Column="0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Content="+ New workspace"
                    Command="{x:Bind ViewModel.NewWorkspaceCommand}"
                    HorizontalAlignment="Stretch"
                    Margin="12,12,12,8"
                    TabIndex="0" />

            <ListView Grid.Row="1"
                      x:Name="WorkspaceListView"
                      ItemsSource="{x:Bind ViewModel.Workspaces}"
                      SelectedItem="{x:Bind ViewModel.SelectedWorkspace, Mode=TwoWay}"
                      SelectionMode="Single"
                      TabIndex="1">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="workspaces:WorkspaceListItemViewModel">
                        <Grid ColumnSpacing="10" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Rename"
                                                    Tag="{x:Bind Id}"
                                                    Click="RenameItem_Click" />
                                    <MenuFlyoutItem Text="Duplicate"
                                                    Tag="{x:Bind Id}"
                                                    Click="DuplicateItem_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete"
                                                    Tag="{x:Bind Id}"
                                                    Click="DeleteItem_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Border Grid.Column="0"
                                    Width="10" Height="10"
                                    CornerRadius="999"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind AccentColorHex, Converter={StaticResource HexToBrushConverter}}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Name}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ─── Right pane ─── -->
        <Grid Grid.Column="1">

            <!-- Empty state: no workspaces exist -->
            <StackPanel Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="380"
                        Spacing="16"
                        Padding="24">
                <FontIcon Glyph="&#xE821;" FontSize="48" Opacity="0.4" HorizontalAlignment="Center" />
                <TextBlock Text="No workspaces yet"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock TextWrapping="Wrap"
                           Text="Workspaces bundle folders, context, system prompts, and memory for a project. Create one to get started."
                           Opacity="0.7"
                           TextAlignment="Center" />
                <Button Content="+ Create workspace"
                        Command="{x:Bind ViewModel.NewWorkspaceCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Editor pane: shown when a workspace is selected -->
            <ScrollViewer Padding="24,16,24,24"
                          Visibility="{x:Bind ViewModel.HasEditor, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="24">

                    <!-- Name row with accent dot -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="16" Height="16"
                                CornerRadius="999"
                                VerticalAlignment="Center"
                                Background="{x:Bind ViewModel.Editor.AccentColorHex, Mode=OneWay, Converter={StaticResource HexToBrushConverter}, FallbackValue=Transparent}" />
                        <TextBox Grid.Column="1"
                                 x:Name="WorkspaceNameBox"
                                 PlaceholderText="Workspace name…"
                                 Text="{x:Bind ViewModel.Editor.Name, Mode=TwoWay}"
                                 TabIndex="2" />
                    </Grid>

                    <!-- Description -->
                    <TextBox PlaceholderText="Description"
                             Text="{x:Bind ViewModel.Editor.Description, Mode=TwoWay}"
                             AcceptsReturn="True"
                             MaxHeight="80"
                             TextWrapping="Wrap"
                             TabIndex="3" />

                    <!-- Folders section -->
                    <StackPanel Spacing="8">
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,16,0,0">
                            <TextBlock Text="Folders"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                        </Border>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Editor.Folders, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="workspaces:WorkspaceFolderViewModel">
                                    <Grid ColumnSpacing="8" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{x:Bind Path, Mode=OneWay}"
                                                 IsReadOnly="True" />
                                        <TextBox Grid.Column="1"
                                                 PlaceholderText="Alias"
                                                 Text="{x:Bind Alias, Mode=TwoWay, FallbackValue=''}" />
                                        <Button Grid.Column="2"
                                                Content="Remove"
                                                Tag="{x:Bind}"
                                                Click="RemoveFolder_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Browse…"
                                Command="{x:Bind ViewModel.Editor.AddFolderCommand, Mode=OneWay}"
                                TabIndex="4" />
                    </StackPanel>

                    <!-- System prompt section -->
                    <StackPanel Spacing="8">
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,16,0,0">
                            <TextBlock Text="System prompt"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                        </Border>
                        <TextBox PlaceholderText="You are a helpful assistant for…"
                                 Text="{x:Bind ViewModel.Editor.SystemPrompt, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 MinHeight="120"
                                 MaxHeight="300"
                                 TextWrapping="Wrap"
                                 TabIndex="5" />
                    </StackPanel>

                    <!-- Action row -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="Discard"
                                Command="{x:Bind ViewModel.DiscardCommand}"
                                TabIndex="6" />
                        <Button Content="Save"
                                Command="{x:Bind ViewModel.Editor.SaveCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.Editor.IsDirty, Mode=OneWay, FallbackValue=False}"
                                Style="{StaticResource AccentButtonStyle}"
                                TabIndex="7" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>
